            },
            {
                "box": {
                    "code": "@state pitchclasses = new buffer(\"pitchclasses\");\n\n// in1 = TTID\nvar ttid = int(in1);\n\n// ----------------------------------------\n// working vars\n// ----------------------------------------\nvar last = 0;\nvar wrapped = 0;\nvar i = 0;\nvar oct = 0;\nvar base = 0;\nvar v = 0;\n\n// ----------------------------------------\n// pitch-class map vars\n// ----------------------------------------\nvar pc0 = 0;   var adj0 = 0;\nvar pc1 = 0;   var adj1 = 0;\nvar pc2 = 0;   var adj2 = 0;\nvar pc3 = 0;   var adj3 = 0;\nvar pc4 = 0;   var adj4 = 0;\nvar pc5 = 0;   var adj5 = 0;\nvar pc6 = 0;   var adj6 = 0;\nvar pc7 = 0;   var adj7 = 0;\nvar pc8 = 0;   var adj8 = 0;\nvar pc9 = 0;   var adj9 = 0;\nvar pc10 = 0;  var adj10 = 0;\nvar pc11 = 0;  var adj11 = 0;\n\n// ----------------------------------------\n// find highest enabled pitch class\n// bit 0 = C, bit 11 = B\n// ----------------------------------------\nfor (i = 11; i >= 0; i -= 1) {\n    if ((ttid >> i) & 1) {\n        last = i;\n        break;\n    }\n}\n\n// if C is absent, entries before first enabled pc\n// are inherited from previous octave\nwrapped = ((ttid >> 0) & 1) ? 0 : 1;\n\n// ----------------------------------------\n// build 12-note inherited pitch map\n// pcN  = inherited pitch class\n// adjN = octave adjustment (0 or -12)\n// ----------------------------------------\nif ((ttid >> 0) & 1) {\n    last = 0;\n    wrapped = 0;\n}\npc0 = last;\nadj0 = wrapped ? -12 : 0;\n\nif ((ttid >> 1) & 1) {\n    last = 1;\n    wrapped = 0;\n}\npc1 = last;\nadj1 = wrapped ? -12 : 0;\n\nif ((ttid >> 2) & 1) {\n    last = 2;\n    wrapped = 0;\n}\npc2 = last;\nadj2 = wrapped ? -12 : 0;\n\nif ((ttid >> 3) & 1) {\n    last = 3;\n    wrapped = 0;\n}\npc3 = last;\nadj3 = wrapped ? -12 : 0;\n\nif ((ttid >> 4) & 1) {\n    last = 4;\n    wrapped = 0;\n}\npc4 = last;\nadj4 = wrapped ? -12 : 0;\n\nif ((ttid >> 5) & 1) {\n    last = 5;\n    wrapped = 0;\n}\npc5 = last;\nadj5 = wrapped ? -12 : 0;\n\nif ((ttid >> 6) & 1) {\n    last = 6;\n    wrapped = 0;\n}\npc6 = last;\nadj6 = wrapped ? -12 : 0;\n\nif ((ttid >> 7) & 1) {\n    last = 7;\n    wrapped = 0;\n}\npc7 = last;\nadj7 = wrapped ? -12 : 0;\n\nif ((ttid >> 8) & 1) {\n    last = 8;\n    wrapped = 0;\n}\npc8 = last;\nadj8 = wrapped ? -12 : 0;\n\nif ((ttid >> 9) & 1) {\n    last = 9;\n    wrapped = 0;\n}\npc9 = last;\nadj9 = wrapped ? -12 : 0;\n\nif ((ttid >> 10) & 1) {\n    last = 10;\n    wrapped = 0;\n}\npc10 = last;\nadj10 = wrapped ? -12 : 0;\n\nif ((ttid >> 11) & 1) {\n    last = 11;\n    wrapped = 0;\n}\npc11 = last;\nadj11 = wrapped ? -12 : 0;\n\n// ----------------------------------------\n// write 240-sample bipolar table\n// sample 0   = -120 semitones\n// sample 120 = 0 semitones\n// sample 239 = +119 semitones\n// ----------------------------------------\nfor (oct = -10; oct < 10; oct += 1) {\n    base = oct * 12 + 120;\n\n    v = (oct * 12) + adj0 + pc0;    poke(pitchclasses, v / 120, base + 0);\n    v = (oct * 12) + adj1 + pc1;    poke(pitchclasses, v / 120, base + 1);\n    v = (oct * 12) + adj2 + pc2;    poke(pitchclasses, v / 120, base + 2);\n    v = (oct * 12) + adj3 + pc3;    poke(pitchclasses, v / 120, base + 3);\n    v = (oct * 12) + adj4 + pc4;    poke(pitchclasses, v / 120, base + 4);\n    v = (oct * 12) + adj5 + pc5;    poke(pitchclasses, v / 120, base + 5);\n    v = (oct * 12) + adj6 + pc6;    poke(pitchclasses, v / 120, base + 6);\n    v = (oct * 12) + adj7 + pc7;    poke(pitchclasses, v / 120, base + 7);\n    v = (oct * 12) + adj8 + pc8;    poke(pitchclasses, v / 120, base + 8);\n    v = (oct * 12) + adj9 + pc9;    poke(pitchclasses, v / 120, base + 9);\n    v = (oct * 12) + adj10 + pc10;  poke(pitchclasses, v / 120, base + 10);\n    v = (oct * 12) + adj11 + pc11;  poke(pitchclasses, v / 120, base + 11);\n}",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-1",
                    "maxclass": "codebox",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 640.0, 454.0, 340.0, 200.0 ],
                    "rnbo_classname": "codebox",
                    "rnbo_extra_attributes": {
                        "nocache": 0,
                        "hot": 0,
                        "code": "@state pitchclasses = new buffer(\"pitchclasses\");\n\n// in1 = TTID\nvar ttid = int(in1);\n\n// ----------------------------------------\n// working vars\n// ----------------------------------------\nvar last = 0;\nvar wrapped = 0;\nvar i = 0;\nvar oct = 0;\nvar base = 0;\nvar v = 0;\n\n// ----------------------------------------\n// pitch-class map vars\n// ----------------------------------------\nvar pc0 = 0;   var adj0 = 0;\nvar pc1 = 0;   var adj1 = 0;\nvar pc2 = 0;   var adj2 = 0;\nvar pc3 = 0;   var adj3 = 0;\nvar pc4 = 0;   var adj4 = 0;\nvar pc5 = 0;   var adj5 = 0;\nvar pc6 = 0;   var adj6 = 0;\nvar pc7 = 0;   var adj7 = 0;\nvar pc8 = 0;   var adj8 = 0;\nvar pc9 = 0;   var adj9 = 0;\nvar pc10 = 0;  var adj10 = 0;\nvar pc11 = 0;  var adj11 = 0;\n\n// ----------------------------------------\n// find highest enabled pitch class\n// bit 0 = C, bit 11 = B\n// ----------------------------------------\nfor (i = 11; i >= 0; i -= 1) {\n    if ((ttid >> i) & 1) {\n        last = i;\n        break;\n    }\n}\n\n// if C is absent, entries before first enabled pc\n// are inherited from previous octave\nwrapped = ((ttid >> 0) & 1) ? 0 : 1;\n\n// ----------------------------------------\n// build 12-note inherited pitch map\n// pcN  = inherited pitch class\n// adjN = octave adjustment (0 or -12)\n// ----------------------------------------\nif ((ttid >> 0) & 1) {\n    last = 0;\n    wrapped = 0;\n}\npc0 = last;\nadj0 = wrapped ? -12 : 0;\n\nif ((ttid >> 1) & 1) {\n    last = 1;\n    wrapped = 0;\n}\npc1 = last;\nadj1 = wrapped ? -12 : 0;\n\nif ((ttid >> 2) & 1) {\n    last = 2;\n    wrapped = 0;\n}\npc2 = last;\nadj2 = wrapped ? -12 : 0;\n\nif ((ttid >> 3) & 1) {\n    last = 3;\n    wrapped = 0;\n}\npc3 = last;\nadj3 = wrapped ? -12 : 0;\n\nif ((ttid >> 4) & 1) {\n    last = 4;\n    wrapped = 0;\n}\npc4 = last;\nadj4 = wrapped ? -12 : 0;\n\nif ((ttid >> 5) & 1) {\n    last = 5;\n    wrapped = 0;\n}\npc5 = last;\nadj5 = wrapped ? -12 : 0;\n\nif ((ttid >> 6) & 1) {\n    last = 6;\n    wrapped = 0;\n}\npc6 = last;\nadj6 = wrapped ? -12 : 0;\n\nif ((ttid >> 7) & 1) {\n    last = 7;\n    wrapped = 0;\n}\npc7 = last;\nadj7 = wrapped ? -12 : 0;\n\nif ((ttid >> 8) & 1) {\n    last = 8;\n    wrapped = 0;\n}\npc8 = last;\nadj8 = wrapped ? -12 : 0;\n\nif ((ttid >> 9) & 1) {\n    last = 9;\n    wrapped = 0;\n}\npc9 = last;\nadj9 = wrapped ? -12 : 0;\n\nif ((ttid >> 10) & 1) {\n    last = 10;\n    wrapped = 0;\n}\npc10 = last;\nadj10 = wrapped ? -12 : 0;\n\nif ((ttid >> 11) & 1) {\n    last = 11;\n    wrapped = 0;\n}\npc11 = last;\nadj11 = wrapped ? -12 : 0;\n\n// ----------------------------------------\n// write 240-sample bipolar table\n// sample 0   = -120 semitones\n// sample 120 = 0 semitones\n// sample 239 = +119 semitones\n// ----------------------------------------\nfor (oct = -10; oct < 10; oct += 1) {\n    base = oct * 12 + 120;\n\n    v = (oct * 12) + adj0 + pc0;    poke(pitchclasses, v / 120, base + 0);\n    v = (oct * 12) + adj1 + pc1;    poke(pitchclasses, v / 120, base + 1);\n    v = (oct * 12) + adj2 + pc2;    poke(pitchclasses, v / 120, base + 2);\n    v = (oct * 12) + adj3 + pc3;    poke(pitchclasses, v / 120, base + 3);\n    v = (oct * 12) + adj4 + pc4;    poke(pitchclasses, v / 120, base + 4);\n    v = (oct * 12) + adj5 + pc5;    poke(pitchclasses, v / 120, base + 5);\n    v = (oct * 12) + adj6 + pc6;    poke(pitchclasses, v / 120, base + 6);\n    v = (oct * 12) + adj7 + pc7;    poke(pitchclasses, v / 120, base + 7);\n    v = (oct * 12) + adj8 + pc8;    poke(pitchclasses, v / 120, base + 8);\n    v = (oct * 12) + adj9 + pc9;    poke(pitchclasses, v / 120, base + 9);\n    v = (oct * 12) + adj10 + pc10;  poke(pitchclasses, v / 120, base + 10);\n    v = (oct * 12) + adj11 + pc11;  poke(pitchclasses, v / 120, base + 11);\n}",
                        "safemath": 1
                    },
